# Public entry point for DMARCo.
#
# Serves the dashboard on APP_DOMAIN and proxies /api/* to the backend, so the
# whole application runs on a single domain with a single certificate.
# Certificates are obtained and renewed automatically, unless Caddy is told to
# serve plain HTTP because something in front of it terminates TLS instead.
#
# Two settings decide how this is served. CADDY_SITE_SCHEME is how Caddy itself
# listens: https, the default, means it obtains a certificate, and http means it
# serves plain HTTP and asks for nothing, which is what a local test or a proxy
# in front of it needs. APP_SCHEME is the address browsers use, which is what
# the backend has to be told, and the two differ whenever something else
# terminates TLS. See "Behind a proxy or a tunnel" in the README.

{
	email {$ACME_EMAIL}
}

{$CADDY_SITE_SCHEME:https}://{$APP_DOMAIN} {
	encode zstd gzip

	header {
		# The dashboard keeps its access token in browser storage, so a script
		# that runs here reads it. Everything it needs, webfonts included, comes
		# from this origin, so nothing else may load at all: no inline script,
		# no other origin, no framing. Inline style has to stay, because the
		# chart components write one.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		# A year, without includeSubDomains: the domain DMARCo is installed on
		# may have siblings its operator serves over plain HTTP.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	handle_path /api/* {
		reverse_proxy php:80 {
			header_up X-Forwarded-Prefix /api
			# Caddy would otherwise report the scheme of its own hop, which is
			# plain HTTP when something in front of it terminated the TLS. The
			# backend marks cookies secure by what it is told here.
			header_up X-Forwarded-Proto {$APP_SCHEME:https}
		}
	}

	handle {
		reverse_proxy dashboard:80
	}
}
