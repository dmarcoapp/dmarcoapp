# DMARCo configuration.
#
# Copy this file to .env and fill in the values, or run install.sh to generate
# it. Everything marked "generated" should be a long random string that is
# unique to your installation.
#
# This file holds the infrastructure only. How reports come in, outgoing email,
# report retention, and IP lookups are kept in the database and set on the
# dashboard's Platform page.

# ------------------------------------------------------------------ Web access
# Domain the dashboard and the API are served on. Must point to this server.
APP_DOMAIN=dmarc.example.com

# Email address used for the Let's Encrypt account.
ACME_EMAIL=you@example.com

# Browser origins allowed to call the API. The dashboard is served from the
# same domain, so this normally only needs to list APP_DOMAIN.
CORS_ALLOW_ORIGIN=^https://dmarc\.example\.com$

# Set to http only when serving without TLS, for example in a local test.
#APP_SCHEME=https

# How Caddy itself listens, which follows APP_SCHEME unless it is set here. The
# two differ in one case: behind a proxy or a tunnel that terminates TLS,
# browsers arrive over https while Caddy serves plain HTTP and asks for no
# certificate. See "Behind a proxy or a tunnel" in the README.
#CADDY_SITE_SCHEME=https

# --------------------------------------------------------------------- Secrets
# Set these before the first start. Postgres and RabbitMQ keep the password they
# are given while they initialize their volume, so changing one here afterwards
# also needs the commands under Troubleshooting in the README.
APP_SECRET=generated
POSTGRES_PASSWORD=generated
RABBITMQ_PASSWORD=generated

# Encrypts the mailbox passwords and the other secrets kept in the database:
# 64 hexadecimal characters, which is what "openssl rand -hex 32" prints. Keep
# a copy with your backups. Without this key the stored secrets cannot be read
# and have to be entered again.
APP_ENCRYPTION_KEY=generated

# --------------------------------------------------- Mail gateway (optional)
# The older way for reports to come in: Postfix receives report email on port
# 25, ClamAV scans it, and the reports are posted to the backend. It runs only
# with mail-gateway in COMPOSE_PROFILES, and it is being retired in favor of
# mailboxes read over IMAP. See "Mail gateway" in the README.
#COMPOSE_PROFILES=mail-gateway

# Domain the gateway receives reports for, pointed here by an MX record. It must
# not receive any other email, because the gateway rejects everything that is
# not a report. Set the same domain on the Platform page.
#MAIL_GATEWAY_DOMAIN=dmarc.example.com

# Public hostname of the gateway, the target of that MX record, APP_DOMAIN when
# left out. Needs an A record to this server.
#SMTP_HOSTNAME=dmarc.example.com

# Certificate the gateway presents: self-signed, real, external, or disabled.
#SMTP_TLS_MODE=self-signed

# Path of your own certificate chain inside the postfix container, used when
# SMTP_TLS_MODE=external.
#SMTP_TLS_CHAIN_FILE=/certs/smtp.pem

# Scan attachments with ClamAV. Setting this to false only skips the scan and
# leaves the scanner running.
#CLAMAV_SCAN_ENABLED=true

# -------------------------------------------------------------------- Versions
# Pin these to a release version instead of latest for reproducible upgrades.
# This recipe needs 0.5 or later.
# A tag is the full release number without its leading v, for example
# BACKEND_VERSION=0.5. The available tags are listed on each component's
# packages page at https://github.com/orgs/dmarcoapp/packages.
BACKEND_VERSION=latest
DASHBOARD_VERSION=latest
MAIL_INBOUND_VERSION=latest
