# DMARCo configuration.
#
# Copy this file to .env and fill in the values, or run install.sh to generate
# it. Everything marked "generated" should be a long random string that is
# unique to your installation.

# ------------------------------------------------------------------ Web access
# Domain the dashboard and the API are served on. Must point to this server.
APP_DOMAIN=dmarc.example.com

# Email address used for the Let's Encrypt account.
ACME_EMAIL=you@example.com

# Browser origins allowed to call the API. The dashboard is served from the
# same domain, so this normally only needs to list APP_DOMAIN.
CORS_ALLOW_ORIGIN=^https://dmarc\.example\.com$

# Set to http only when serving without TLS, for example in a local test.
#APP_SCHEME=https

# ------------------------------------------------------------- Inbound reports
# Domain your DMARC reports are sent to, pointed here by an MX record. It must
# not receive any other email, because DMARCo rejects everything that is not a
# report. Using APP_DOMAIN is the simplest setup and needs no extra DNS.
REPORT_DOMAIN=dmarc.example.com

# Public hostname of this mail server, the target of that MX record. Needs an
# A record to this server, which APP_DOMAIN already has.
SMTP_HOSTNAME=dmarc.example.com

# Certificate used for inbound SMTP: self-signed, real, external, or disabled.
# See the README for how to switch to a publicly trusted certificate.
SMTP_TLS_MODE=self-signed

# Path of your own certificate chain inside the postfix container, used when
# SMTP_TLS_MODE=external.
#SMTP_TLS_CHAIN_FILE=/certs/smtp.pem

# -------------------------------------------------------------- Outgoing email
# DMARCo sends account emails, such as verification and two-factor codes, so a
# working SMTP account is required. Percent-encode special characters in the
# user name and password, for example @ as %40 and / as %2F.
MAILER_DSN=smtp://user:password@smtp.example.com:587

# Sender address of those emails.
APP_EMAIL_SENDER_ADDRESS=dmarco@example.com

# --------------------------------------------------------------------- Secrets
# Set these before the first start. Postgres and RabbitMQ keep the password they
# are given while they initialize their volume, so changing one here afterwards
# also needs the commands under Troubleshooting in the README.
APP_SECRET=generated
WEBHOOK_SECRET=generated
POSTGRES_PASSWORD=generated
RABBITMQ_PASSWORD=generated
S3_ACCESS_KEY=generated
S3_SECRET_KEY=generated

# --------------------------------------------------------------------- Options
# Public sign-up. Leave both as they are for a private instance, and create
# accounts with: docker compose exec php bin/console app:user:create --simple
APP_REGISTRATION_ENABLED=false
DASHBOARD_DISABLE_REGISTRATION=true

# Days to keep processed reports. 0 disables automatic deletion.
APP_REPORT_RETENTION_DAYS=365

# Scan attachments with ClamAV. Setting this to false only skips the scan and
# leaves the scanner running. See the README for how to remove it completely.
CLAMAV_SCAN_ENABLED=true

# -------------------------------------------------------------------- Versions
# Pin these to a release version instead of latest for reproducible upgrades,
# for example BACKEND_VERSION=2. The available tags are listed on each
# component's packages page at https://github.com/orgs/dmarcoapp/packages.
BACKEND_VERSION=latest
DASHBOARD_VERSION=latest
MAIL_INBOUND_VERSION=latest
